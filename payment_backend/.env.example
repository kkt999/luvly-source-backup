# Server-only. Copy to .env locally; never paste the key into chat or Flutter.
TOYYIBPAY_ENV=sandbox
TOYYIBPAY_CATEGORY_CODE=w8n5i4lf
TOYYIBPAY_SECRET_KEY=
# Public HTTPS endpoints are required before a real sandbox checkout can run.
PAYMENT_RETURN_URL=
PAYMENT_CALLBACK_URL=
# Firebase Console > Project settings > Service accounts. Keep JSON locally here.
GOOGLE_APPLICATION_CREDENTIALS=./secrets/firebase-admin.json
FIREBASE_PROJECT_ID=luvly-44c77
PAYMENT_PORT=8787
# Exact web portal origin, e.g. http://localhost:5000. No wildcard CORS.
PAYMENT_ALLOWED_ORIGINS=

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Licensed TurboSquid model: local debug review only, never commit the raw asset.
/android/app/src/debug/assets/local_review/*.glb

# Payment credentials are server-only; never ship them with Flutter assets.
/payment_backend/.env
/payment_backend/.env.local
/payment_backend/secrets/
/payment_backend/node_modules/

# Local environment, signing, caches, and backup copies
**/.env
**/.env.*
!**/.env.example
**/secrets/
!**/secrets/*.example.json
**/node_modules/
**/.gradle/
**/.kotlin/
**/.firebase/
**/.cxx/
**/build/
**/failures/
/output/
/work/
